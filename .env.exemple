# ==============================================================================
# Configuration Générale 
# ==============================================================================

# Configuration du serveur Ollama IUT
OLLAMA_BASE_URL=http://10.22.28.190:11434
# Modèle de référence du serveur IUT.
OLLAMA_MODEL=gemma4:26b
# Pour le mode Docker local sur une machine limitée en RAM, utiliser par
# exemple gemma4:12b (décommenter la ligne ci-dessous et adapter la valeur) :
# OLLAMA_MODEL=gemma4:12b
OLLAMA_TIMEOUT_S=300

# Fenêtre de contexte Ollama (en tokens). Sans cette variable, Ollama utilise
# par défaut une fenêtre réduite (souvent 2048-4096 tokens) même si le modèle
# en supporte souvent bien plus : un diff volumineux peut alors
# être tronqué silencieusement par le serveur.
OLLAMA_NUM_CTX=32768

# Mode hors-ligne / démo interface complète (true / false)
MOCK_INTERFACE=false

# Simulation de l'IA hors-ligne sans serveur Ollama (true / false)
MOCK_AI=false

# Serveur Ollama local lancé via Docker (true / false)
USE_DOCKER_LLM=false

# Notifications de fin d'inférence de l'IA (true / false)
# Déclenche une notification système de bureau lorsque le modèle termine une tâche
ENABLE_NOTIFICATIONS=true

# Interpréteur Python à utiliser pour le backend (chemin complet vers
# l'exécutable). Laisser vide pour la détection automatique : environnement
# virtuel .venv à la racine de l'application (créé par
# scripts/setup_python_env.py) en priorité, sinon l'interpréteur système
# (python sous Windows, python3 ailleurs).
PYTHON_BIN=
